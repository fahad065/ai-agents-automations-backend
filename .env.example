PORT=4000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# Public URL of THIS backend (no path/trailing slash — used to build chatbot
# embed code + webhook URLs as {BACKEND_URL}/api/v1/...). Set this to your
# actual Railway/production backend domain, e.g. https://api.logicmate.io
BACKEND_URL=http://localhost:4000

# Encryption (for storing API keys)
ENCRYPTION_KEY=32_char_random_string_here

PYTHON_SERVICE_URL=http://localhost:8001