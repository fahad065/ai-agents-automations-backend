PORT=4000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# Public URL of THIS backend (no path/trailing slash — used to build chatbot
# embed code + webhook URLs as {BACKEND_URL}/api/v1/...). Set this to your
# actual Railway/production backend domain, e.g. https://api.logicmate.io
BACKEND_URL=http://localhost:4000

# Encryption (for storing API keys)
ENCRYPTION_KEY=32_char_random_string_here

PYTHON_SERVICE_URL=http://localhost:8001
# Cloudflare R2 file storage — see docs/cloudflare-r2-setup.md
# Local/staging use the dev buckets; production (Railway) the prod ones.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET=logicmate-dev-public
R2_PRIVATE_BUCKET=logicmate-dev-private
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
